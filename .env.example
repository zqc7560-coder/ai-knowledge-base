# 复制本文件为 backend/.env 并填入真实值。本文件只放占位符，真实密钥严禁写入任何会提交的文件。
# AI（阿里云百炼 DashScope）——服务端专用，前端不可见
AI_API_KEY=<在此填入 DashScope API Key，绝不要提交含真实值的文件>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIM=1024
AI_RERANK_MODEL=gte-rerank-v2

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=kb_system
MYSQL_USER=kb_app
MYSQL_PASSWORD=***

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL + pgvector（向量库）
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=kb_vectors
PGVECTOR_USER=kb_app
PGVECTOR_PASSWORD=***

# 上传限制
MAX_UPLOAD_MB=20
