# 复制本文件为 backend/.env 并填入真实值。真实密钥严禁写入任何会提交的文件。
# AI (DashScope) - server-side only
AI_API_KEY=REPLAC...EY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIM=1024
AI_RERANK_MODEL=gte-rerank-v2

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=kb_system
MYSQL_USER=kb_app
MYSQL_PASSWORD=db_change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL + pgvector
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=kb_vectors
PGVECTOR_USER=kb_app
PGVECTOR_PASSWORD=pg_change_me

# upload limit
MAX_UPLOAD_MB=20
