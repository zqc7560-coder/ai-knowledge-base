<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.kb</groupId><artifactId>kb-parent</artifactId><version>0.1.0</version></parent>
  <artifactId>kb-rag</artifactId>
  <dependencies>
    <dependency><groupId>com.kb</groupId><artifactId>kb-common</artifactId><version>${project.version}</version></dependency>
    <!-- M12.1 Milvus 官方 gRPC SDK（版本与服务端 v2.3.16 同线） -->
    <dependency><groupId>io.milvus</groupId><artifactId>milvus-sdk-java</artifactId><version>2.3.10</version>
      <!-- SDK 把 bulk-import(parquet/hdfs) 做成 compile 传递依赖，本项目只用 CRUD：
           不排除 fat-jar 194MB（hadoop 全家桶 ~110MB），排除后回到常规体量。
           若将来真用 bulkInsert 再移除此块。 -->
      <exclusions>
        <exclusion><groupId>org.apache.hadoop</groupId><artifactId>hadoop-client</artifactId></exclusion>
        <exclusion><groupId>org.apache.parquet</groupId><artifactId>parquet-hadoop</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j</artifactId></dependency>
    <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j-open-ai</artifactId></dependency>
    <dependency><groupId>dev.langchain4j</groupId><artifactId>langchain4j-pgvector</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId></dependency>
    <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
